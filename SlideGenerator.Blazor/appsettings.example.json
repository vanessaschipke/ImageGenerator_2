{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "SlideGenerator": "Information"
    }
  },
  "AllowedHosts": "*",

  "AzureImage": {
    "Endpoint": "https://<deine-resource>.openai.azure.com",
    "ApiKey": "<dein-azure-openai-key>",
    "DeploymentName": "gpt-image-2.5-flare",
    "ChatDeploymentName": "gpt-5",
    "ApiVersion": "2025-04-01-preview",
    "DefaultSize": "1536x1024",
    "DefaultQuality": "high",
    "MasterPrompt": "Erstelle die Grafik im Rohde & Schwarz Corporate Design: Hauptfarbe Dunkelblau #003c7e, Akzentfarbe Hellblau #0099cc, klare moderne Typografie, viel Weissraum, professioneller Bild-Stil, Querformat-Komposition (3:2)."
  },

  "AzureStorageBlob": {
    "Endpoint": "https://<storageaccount>.blob.core.windows.net",
    "ContainerName": "slidegenerator-data"
  }
}
